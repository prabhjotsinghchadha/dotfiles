*.log

# Compiled Lua bytecode
*.luac

# LSP logs
lsp.log
lsp-*.log

# Debug files
.luarc.json

# OS specific
.DS_Store
Thumbs.db

# Personal notes or local configs (if you create them)
local.lua
personal.lua
